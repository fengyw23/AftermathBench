# Preserve raw execution and service logs byte-for-byte and keep whitespace
# diagnostics focused on source and documentation.
data/evidence/**/compose.log -text -diff
data/evidence/**/compose-ps.txt -text -diff
data/evidence/**/runs/**/*.log -text -diff

# Hash-bound text evidence must have identical bytes on every checkout.
data/evidence/**/*.json text eol=lf
data/evidence/**/*.txt text eol=lf
data/evidence/**/*.md text eol=lf
data/evidence/**/*.patch text eol=lf
data/evidence/**/*.py text eol=lf
data/evidence/**/*.sh text eol=lf
data/evidence/**/*.toml text eol=lf
data/evidence/**/*.yaml text eol=lf
data/evidence/**/*.yml text eol=lf
data/evidence/**/*Containerfile text eol=lf

# Release manifests hash scenario/spec bytes, so these source records must be
# identical on Windows and Linux checkouts.
data/scenarios/**/*.json text eol=lf
data/scenario_blueprints/**/*.json text eol=lf
data/instance_specs/**/*.json text eol=lf
data/benchmark_matrix.json text eol=lf
data/release_manifest.json text eol=lf
schemas/**/*.json text eol=lf
