{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fengyw23/AftermathBench/schemas/formal-evidence-declarations-v1.schema.json",
  "title": "AftermathBench completed two-phase formal evidence declarations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "benchmark_release_id",
    "scenario_id",
    "domain_id",
    "family_id",
    "instance_id",
    "variant_ids",
    "producer_commit",
    "scenario_path",
    "formal_input_lock",
    "formal_evidence",
    "control_evidence"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "formal_evidence_declarations"},
    "benchmark_release_id": {"$ref": "#/$defs/identifier"},
    "scenario_id": {"$ref": "#/$defs/identifier"},
    "domain_id": {"$ref": "#/$defs/identifier"},
    "family_id": {"$ref": "#/$defs/identifier"},
    "instance_id": {"$ref": "#/$defs/identifier"},
    "variant_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "scenario_path": {
      "type": "string",
      "pattern": "^data/scenarios/[A-Za-z0-9._-]+/scenario\\.json$"
    },
    "formal_input_lock": {
      "allOf": [
        {"$ref": "#/$defs/declaration"},
        {
          "properties": {
            "path": {
              "pattern": "^data/.+/formal-input-lock\\.json$"
            }
          }
        }
      ]
    },
    "formal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_contract",
        "evaluator",
        "reset_evidence",
        "boundary_bundle",
        "reference_bundle",
        "raw_run_archive",
        "execution_control"
      ],
      "properties": {
        "tool_contract": {"$ref": "#/$defs/input_declaration"},
        "evaluator": {"$ref": "#/$defs/input_declaration"},
        "reset_evidence": {"$ref": "#/$defs/input_declaration"},
        "boundary_bundle": {"$ref": "#/$defs/input_declaration"},
        "reference_bundle": {"$ref": "#/$defs/input_declaration"},
        "raw_run_archive": {"$ref": "#/$defs/completion_declaration"},
        "execution_control": {"$ref": "#/$defs/completion_declaration"}
      }
    },
    "control_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "minimum_task_pass_rate"],
      "properties": {
        "path": {"$ref": "#/$defs/data_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "minimum_task_pass_rate": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1.0
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_path": {
      "type": "string",
      "pattern": "^data/[A-Za-z0-9._/-]+$"
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/data_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_declaration": {
      "allOf": [
        {"$ref": "#/$defs/declaration"},
        {
          "properties": {
            "path": {
              "pattern": "^data/.+/roles/[a-z_]+/envelope\\.json$"
            }
          }
        }
      ]
    },
    "completion_declaration": {
      "allOf": [
        {"$ref": "#/$defs/declaration"},
        {
          "properties": {
            "path": {
              "pattern": "^data/.+/completion/roles/[a-z_]+/envelope\\.json$"
            }
          }
        }
      ]
    }
  }
}
