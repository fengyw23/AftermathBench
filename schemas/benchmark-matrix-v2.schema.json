{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fengyw23/AftermathBench/schemas/benchmark-matrix-v2.schema.json",
  "title": "AftermathBench target matrix",
  "type": "object",
  "required": [
    "schema_version",
    "target_release",
    "release_requirements",
    "boundary_taxonomy",
    "domains"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "target_release": {"const": "top-conference-full"},
    "release_requirements": {
      "type": "object",
      "required": [
        "domain_count",
        "families_per_domain",
        "instances_per_family",
        "public_dev_per_family",
        "hidden_test_per_family"
      ]
    },
    "boundary_taxonomy": {
      "type": "array",
      "minItems": 4
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain_id", "runtime", "families"],
        "properties": {
          "domain_id": {"type": "string", "minLength": 1},
          "runtime": {"type": "string", "minLength": 1},
          "families": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "family_id",
                "error_operation",
                "native_entities",
                "independent_branches",
                "protected_effects",
                "required_recovery_signatures",
                "variant_profile",
                "instances"
              ],
              "properties": {
                "family_id": {"type": "string", "minLength": 1},
                "variant_profile": {
                  "type": "object",
                  "required": [
                    "required_variant_count",
                    "minimum_recovery_signatures",
                    "minimum_boundary_classes"
                  ]
                },
                "instances": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "split"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "split": {
                        "enum": ["public_dev", "hidden_test"]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
